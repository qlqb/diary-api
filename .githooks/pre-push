#!/usr/bin/env bash
#
# 스크립트 하나만 부른다. 훅이 커지면 아무도 읽지 않고, 읽지 않는 훅은 --no-verify로 꺼진다.
#
# 켜는 법(클론마다 한 번):
#   git config core.hooksPath .githooks
#
# git이 stdin으로 "<local ref> <local sha> <remote ref> <remote sha>"를 준다.

set -uo pipefail

ROOT="$(git rev-parse --show-toplevel)"
ZERO='0000000000000000000000000000000000000000'
STATUS=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  # 브랜치 삭제. 올라가는 내용이 없다.
  [ "$local_sha" = "$ZERO" ] && continue

  if [ "$remote_sha" = "$ZERO" ]; then
    # 새 브랜치. 원격 어디에도 없는 커밋 전부가 이번에 올라간다.
    RANGE=""
  else
    RANGE="$remote_sha..$local_sha"
  fi

  bash "$ROOT/scripts/check-private-names.sh" $RANGE || STATUS=1
done

exit "$STATUS"
