<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.jungwoo.project.memo.material.MaterialLinkMapper">

    <resultMap id="materialLinkResultMap" type="com.jungwoo.project.memo.material.domain.MaterialLink">
        <id     property="linkId"       column="link_id"/>
        <result property="userId"       column="user_id"/>
        <result property="materialId"   column="material_id"/>
        <result property="courseId"     column="course_id"/>
        <result property="materialType" column="material_type"/>
        <result property="linkedAt"     column="linked_at"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="linkId">
        INSERT INTO material_links (user_id, material_id, course_id, material_type)
        VALUES (#{userId}, #{materialId}, #{courseId}, #{materialType})
    </insert>

    <select id="findByMaterialIdAndCourseIdAndUserId" resultMap="materialLinkResultMap">
        SELECT * FROM material_links
        WHERE material_id = #{materialId} AND course_id = #{courseId} AND user_id = #{userId}
    </select>

    <select id="findByCourseIdAndUserId" resultMap="materialLinkResultMap">
        SELECT * FROM material_links
        WHERE course_id = #{courseId} AND user_id = #{userId}
    </select>

</mapper>
