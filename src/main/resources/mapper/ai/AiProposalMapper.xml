<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.jungwoo.project.memo.ai.AiProposalMapper">

    <resultMap id="aiProposalResultMap"
               type="com.jungwoo.project.memo.ai.domain.AiProposal">
        <id     property="proposalId"     column="proposal_id"/>
        <result property="userId"         column="user_id"/>
        <result property="conversationId" column="conversation_id"/>
        <result property="targetScope"    column="target_scope"/>
        <result property="status"         column="status"/>
        <result property="createdAt"      column="created_at"/>
        <result property="expiresAt"      column="expires_at"/>
        <result property="respondedAt"    column="responded_at"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="proposalId">
        INSERT INTO ai_proposals (
            user_id,
            conversation_id,
            target_scope,
            status,
            expires_at
        ) VALUES (
            #{userId},
            #{conversationId},
            #{targetScope},
            #{status},
            #{expiresAt}
        )
    </insert>

    <select id="findByIdAndUserId" resultMap="aiProposalResultMap">
        SELECT *
        FROM ai_proposals
        WHERE proposal_id = #{proposalId}
          AND user_id     = #{userId}
    </select>

    <select id="findByIdAndUserIdForUpdate" resultMap="aiProposalResultMap">
        SELECT *
        FROM ai_proposals
        WHERE proposal_id = #{proposalId}
          AND user_id     = #{userId}
        FOR UPDATE
    </select>

    <update id="updateStatusAndRespondedAt">
        UPDATE ai_proposals
        SET status       = #{status},
            responded_at = #{respondedAt}
        WHERE proposal_id = #{proposalId}
          AND user_id     = #{userId}
    </update>

</mapper>
