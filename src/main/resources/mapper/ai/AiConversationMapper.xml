<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.jungwoo.project.memo.ai.AiConversationMapper">

    <resultMap id="aiConversationResultMap"
               type="com.jungwoo.project.memo.ai.domain.AiConversation">
        <id     property="conversationId" column="conversation_id"/>
        <result property="userId"         column="user_id"/>
        <result property="scope"          column="scope"/>
        <result property="status"         column="status"/>
        <result property="summary"        column="summary"/>
        <result property="createdAt"      column="created_at"/>
        <result property="updatedAt"      column="updated_at"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="conversationId">
        INSERT INTO ai_conversations (
            user_id,
            scope,
            status
        ) VALUES (
            #{userId},
            #{scope},
            #{status}
        )
    </insert>

    <select id="findByIdAndUserId" resultMap="aiConversationResultMap">
        SELECT *
        FROM ai_conversations
        WHERE conversation_id = #{conversationId}
          AND user_id         = #{userId}
    </select>

    <update id="touchUpdatedAt">
        UPDATE ai_conversations
        SET updated_at = CURRENT_TIMESTAMP
        WHERE conversation_id = #{conversationId}
          AND user_id         = #{userId}
    </update>

</mapper>
