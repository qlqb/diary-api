<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.jungwoo.project.memo.execution.ExecutionRecordMapper">

    <resultMap id="executionRecordResultMap"
               type="com.jungwoo.project.memo.execution.domain.ExecutionRecord">
        <id     property="executionRecordId"        column="execution_record_id"/>
        <result property="userId"                   column="user_id"/>
        <result property="executionItemId"          column="execution_item_id"/>
        <result property="outcome"                  column="outcome"/>
        <result property="startedAt"                column="started_at"/>
        <result property="endedAt"                  column="ended_at"/>
        <result property="actualMinutes"             column="actual_minutes"/>
        <result property="completionPercent"        column="completion_percent"/>
        <result property="note"                     column="note"/>
        <result property="remainingExecutionItemId" column="remaining_execution_item_id"/>
        <result property="recordedAt"               column="recorded_at"/>
        <result property="createdAt"                column="created_at"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="executionRecordId">
        INSERT INTO execution_records (
            user_id,
            execution_item_id,
            outcome,
            started_at,
            ended_at,
            actual_minutes,
            completion_percent,
            note,
            remaining_execution_item_id
        ) VALUES (
            #{userId},
            #{executionItemId},
            #{outcome},
            #{startedAt},
            #{endedAt},
            #{actualMinutes},
            #{completionPercent},
            #{note},
            #{remainingExecutionItemId}
        )
    </insert>

</mapper>
