<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.jungwoo.project.memo.learning.TopicLearningEventMapper">

    <resultMap id="topicLearningEventResultMap" type="com.jungwoo.project.memo.learning.domain.TopicLearningEvent">
        <id     property="eventId"         column="event_id"/>
        <result property="userId"          column="user_id"/>
        <result property="topicId"         column="topic_id"/>
        <result property="executionItemId" column="execution_item_id"/>
        <result property="eventType"       column="event_type"/>
        <result property="fromStatus"      column="from_status"/>
        <result property="toStatus"        column="to_status"/>
        <result property="note"            column="note"/>
        <result property="createdAt"       column="created_at"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="eventId">
        INSERT INTO topic_learning_events (
            user_id, topic_id, execution_item_id, event_type, from_status, to_status, note
        ) VALUES (
            #{userId}, #{topicId}, #{executionItemId}, #{eventType}, #{fromStatus}, #{toStatus}, #{note}
        )
    </insert>

    <select id="findRecentByUserIdAndTopicId" resultMap="topicLearningEventResultMap">
        SELECT * FROM topic_learning_events
        WHERE user_id = #{userId} AND topic_id = #{topicId}
        ORDER BY created_at DESC, event_id DESC
        LIMIT #{limit}
    </select>

</mapper>
